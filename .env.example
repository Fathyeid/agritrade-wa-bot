# AgriTrade WhatsApp bot — environment variables
# Copy to .env (locally) or set in the Render dashboard.

# WhatsApp numbers (digits only, with country code, no +)
PAIRING_PHONE=201290013088     # side number the bot runs on
ADMIN_PHONE=201032287622       # Fathy's main number — admin commands

# Supabase (AgriTrade project)
SUPABASE_URL=https://movodjdwghharkfrgqtv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service role key — server side only, never public

# Optional: Gemini free-tier Q&A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Secret for the /pairing-code endpoint
ADMIN_SECRET=change-me

# Keep-alive self-ping (Render sets RENDER_EXTERNAL_URL automatically; locally leave empty)
SELF_URL=

# Safety caps
MAX_BROADCAST=150

# Testing without connecting to WhatsApp
DRY_RUN=

PORT=10000
